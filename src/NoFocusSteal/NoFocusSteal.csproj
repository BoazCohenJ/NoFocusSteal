<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with every Windows 10 and 11 install, so the .exe runs with nothing to install. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>NoFocusSteal</RootNamespace>
    <AssemblyName>NoFocusSteal</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.1.0</Version>
    <Product>NoFocusSteal</Product>
    <Description>Stops apps from stealing focus on Windows and logs which app tried.</Description>
    <Copyright>Copyright (c) 2026 BoazCohenJ</Copyright>
    <Company>NoFocusSteal</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="NoFocusSteal.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoFocusSteal.Tests" />
  </ItemGroup>

</Project>
